# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO (PLANTILLA SEGURA)
# ==============================================================================
# Copia este archivo a '.env' y completa los valores con tus credenciales reales:
#   cp .env.example .env
# NUNCA subas el archivo '.env' con claves reales al repositorio Git.
# ==============================================================================

# Configuración del Servidor y Entorno
PORT=8080
HTTPS_PORT=8443
NODE_ENV=production
DEBUG=false

# Claves de Proveedores de Inteligencia Artificial (Opcionales)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Obtén tu clave en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-tu_api_key_aqui

# Obtén tu clave en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-tu_api_key_aqui

# Obtén tu clave en: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-tu_api_key_aqui

# Obtén tu clave gratuita en: https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_api_key_aqui

# Obtén tu clave en: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-tu_api_key_aqui

# Obtén tu clave en: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=csk-tu_api_key_aqui

# LibreTranslate Backend URL (Interno Docker)
LIBRETRANSLATE_URL=http://libretranslate:5000
