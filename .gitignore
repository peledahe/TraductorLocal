# ==========================================
# GitIgnore para Traductor Local (Merke)
# ==========================================

# Entornos virtuales y dependencias de Python
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Bytecode y caché de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Modelos descargados de LibreTranslate / Argos Translate (pesan varios GB)
data/libretranslate/*
!data/libretranslate/.gitkeep

# Certificados SSL y claves privadas generadas localmente
data/certs/*
!data/certs/.gitkeep
*.pem
*.key
*.crt
*.csr
*.srl
*.p12
*.pfx

# Archivos de entorno y credenciales
.env
.env.local
.env.*.local
*.env

# Archivos de configuración de editores e IDEs
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Archivos del sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
