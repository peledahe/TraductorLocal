# ==============================================================================
# .gitignore - CONFIGURACIÓN DE SEGURIDAD Y REGLAS DE PRODUCCIÓN
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SEGURIDAD, SECRETOS, CLAVES Y CREDENCIALES (NUNCA COMMITEAR)
# ------------------------------------------------------------------------------
# Variables de entorno y secretos
.env
.env.*
*.env
!.env.example

# Archivos de configuración local con credenciales
data/ai_config.json
*config.local.json
*secrets*.json
*credentials*.json

# Certificados SSL, claves privadas y tokens criptográficos
data/certs/*
!data/certs/.gitkeep
*.pem
*.key
*.crt
*.csr
*.srl
*.p12
*.pfx
*.pkcs12
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.keystore
*.jks

# Tokens de servicios y credenciales de nubes
service-account*.json
gcp-key*.json
*firebase-adminsdk*.json

# ------------------------------------------------------------------------------
# 2. DEPENDENCIAS Y ENTORNOS VIRTUALES
# ------------------------------------------------------------------------------
# Python (Venv / Virtualenv / Conda)
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
conda/

# Node.js / JavaScript
node_modules/
jspm_packages/
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# 3. ARTEFACTOS DE COMPILACIÓN, CACHÉ Y SALIDAS (BUILD OUTPUTS)
# ------------------------------------------------------------------------------
# Bytecode y caché de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/

# Salidas de frontend y compiladores (Webpack, Vite, Rollup, Rust/Cargo, etc.)
out/
.next/
.nuxt/
target/

# ------------------------------------------------------------------------------
# 4. MODELOS PESADOS Y ALMACENAMIENTO DE DATOS LOCAL
# ------------------------------------------------------------------------------
# Modelos pesados de traducción (LibreTranslate / Argos Translate > 3GB)
data/libretranslate/*
!data/libretranslate/.gitkeep

# Base de datos SQLite o volcados locales temporales
*.sqlite
*.sqlite3
*.db
*.dump

# ------------------------------------------------------------------------------
# 5. CONFIGURACIÓN ESPECÍFICA DE IDES Y EDITORES
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak

# ------------------------------------------------------------------------------
# 6. ARCHIVOS GENERADOS POR EL SISTEMA OPERATIVO
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.trash

# ------------------------------------------------------------------------------
# 7. LOGS, REPORTES DE ERROR Y ARCHIVOS TEMPORALES
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock
tmp/
temp/
